rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidBoundedIdArray(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || isValidId(arr[0]));
    }

    function isValidCollectorProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'wishlistIds',
          'recentProductIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'wishlistIds',
          'recentProductIds',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidString(data.email, 3, 254)
        && isValidString(data.displayName, 1, 120)
        && isValidBoundedIdArray(data.wishlistIds, 30)
        && isValidBoundedIdArray(data.recentProductIds, 12)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidCollectorProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidCollectorProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['wishlistIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['recentProductIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['wishlistIds', 'recentProductIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'wishlistIds', 'recentProductIds', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Connection check document used exclusively at startup via getDocFromServer('test/connection')
    match /test/connection {
      allow read: if false;
      allow write: if false;
    }
  }
}
